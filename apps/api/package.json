    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "drizzle-orm": "^0.38.4",
    "elysia": "^1.2.10",
    "nanoid": "^5.0.9",
    "postgres": "^3.4.5",
    "resend": "^4.1.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.7.3"
