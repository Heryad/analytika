{
  "name": "@analytika-me/tracker",
  "version": "1.0.0",
  "description": "High-performance, cookieless, privacy-friendly web analytics & revenue attribution tracker",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./script": "./dist/a.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "analytics",
    "privacy",
    "telemetry",
    "gdpr",
    "cookieless",
    "revenue",
    "mrr",
    "attribution"
  ],
  "author": "Analytika",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
