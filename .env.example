# ==========================================
# Analytika Platform - Environment Config
# ==========================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Authentication (JWT & Resend OTP)
JWT_SECRET=super_secret_jwt_key_change_me_in_production_123456789
RESEND_API_KEY=re_123456789_your_resend_api_key
RESEND_FROM_EMAIL=auth@analytika.dev

# PostgreSQL (Transactional DB for Users, Auth, Websites, Polar Subscriptions)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/analytika

# ClickHouse (High-Speed OLAP Database for Events & Funnels)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=analytika

# Polar.sh Billing
POLAR_ACCESS_TOKEN=polar_at_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=polar_whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLAR_ORGANIZATION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: GeoIP MaxMind or Free IP API endpoint
GEOIP_ENABLED=true
