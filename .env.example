# ==========================================
# Analytika Platform — Environment Config
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication (JWT & Session Encryption)
# Generate with: openssl rand -hex 32
JWT_SECRET=analytika_super_secure_jwt_secret_key_2026_x99
ENCRYPTION_KEY=analytika_aes256_master_key_99x

# Resend Transactional Email Service (OTP Codes & Alerts)
RESEND_API_KEY=re_123456789_your_resend_api_key
RESEND_FROM_EMAIL=Analytika <noreply@analytika.me>

# PostgreSQL (Transactional DB for Users, Auth, Websites, Polar Subscriptions)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=analytika
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/analytika

# ClickHouse (High-Speed OLAP Database for Events, Maps & MRR)
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhousepassword
CLICKHOUSE_DB=analytika

# Polar.sh Billing & Webhooks
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=polar_whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLAR_ORGANIZATION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# Fider Feedback Board (feedback.yourdomain.com)
# ==========================================
# Generate with: openssl rand -hex 32
FIDER_JWT_SECRET=change_this_to_a_long_random_secret

# Your Resend API key (same key works, or create a separate one)
FIDER_SMTP_PASSWORD=re_your_resend_api_key

# The public URL of your feedback board
FIDER_BASE_URL=https://feedback.yourdomain.com

# Optional overrides (defaults work for Resend out of the box)
# FIDER_SMTP_HOST=smtp.resend.com
# FIDER_SMTP_PORT=2587          ← port 2587 + STARTTLS=true for Resend (587/465 often blocked by VPS)
# FIDER_SMTP_USERNAME=resend
# FIDER_EMAIL_NOREPLY=noreply@yourdomain.com

# ==========================================
# SETUP CHECKLIST (production)
# ==========================================
# 1. Copy this file to .env and fill in all values
# 2. Create the fider database:
#    docker exec -it analytika-postgres psql -U postgres -c "CREATE DATABASE fider;"
# 3. Add DNS A record: feedback.yourdomain.com → your VPS IP
# 4. Add Caddy block for feedback.yourdomain.com → 127.0.0.1:3010
# 5. docker compose -f docker-compose.prod.yml up -d
